{
  "name": "@kosh/permissions",
  "version": "0.0.0",
  "description": "Roles, groups, ACL, field security, action permissions and approval rules on Shutro security (RFC 0003)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "@kosh/source": "./src/web/index.ts",
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kosh/modules-sdk": "workspace:*",
    "@kosh/server": "workspace:*",
    "fastify": "^5.12.7",
    "@kosh/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.3",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/react": "^19.3.0"
  }
}
