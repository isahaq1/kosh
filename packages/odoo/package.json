{
  "name": "@kosh/odoo",
  "version": "0.1.0",
  "private": true,
  "description": "Leave Odoo safely: read a live Odoo over JSON-RPC, map its records, import them with their Odoo ids and prove it with a reconciliation report (RFC 0034)",
  "keywords": [
    "kosh",
    "erp",
    "odoo",
    "migration",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/packages/odoo#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "packages/odoo"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kosh/server": "workspace:*"
  }
}
