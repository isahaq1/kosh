{
  "name": "@kosh/mail",
  "version": "0.1.0",
  "private": true,
  "description": "Email: the SMTP mailer, a plain layout, and inbound email with its quarantine (RFC 0006)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "@kosh/source": "./src/web/index.ts",
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kosh/messaging": "workspace:*",
    "@kosh/modules-sdk": "workspace:*",
    "@kosh/server": "workspace:*",
    "@kosh/storage": "workspace:*",
    "@kosh/ui": "workspace:*",
    "fastify": "^5.12.7",
    "imapflow": "^2.9.1",
    "lucide-react": "^1.59.0",
    "nodemailer": "^7.0.13",
    "postal-mime": "^4.1.4",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-i18next": "^17.0.21",
    "testcontainers": "^12.2.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-i18next": "^17.0.21"
  }
}
