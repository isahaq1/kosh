  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "shutro-erp": "./dist/bin.js",
    "kosh": "./dist/bin.js"
