{
  "name": "@kosh/ui",
  "version": "0.1.0",
  "private": true,
  "description": "React app shell, design system and view renderers (RFC 0007)",
  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./vite": {
      "@kosh/source": "./src/pwa/vite.ts",
      "types": "./dist/pwa/vite.d.ts",
      "default": "./dist/pwa/vite.js"
    }
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@kosh/search": "workspace:*",
    "@kosh/views": "workspace:*",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "@tanstack/react-query-persist-client": "^5.104.5"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@tanstack/react-query": "^5.104.3",
    "i18next": "^26.4.7",
    "react-i18next": "^17.0.21",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@tanstack/react-query": "^5.104.3",
    "i18next": "^26.4.7",
    "react-i18next": "^17.0.21",
    "vite": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
