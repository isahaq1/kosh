{
  "name": "@kosh/automation",
  "version": "0.1.0",
  "private": true,
  "description": "The automation builder: \"when X, then Y\" rules on Shutro's audit trail and outbox, with a run log (RFC 0011)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kosh/messaging": "workspace:*",
    "@kosh/modules-sdk": "workspace:*",
    "@kosh/server": "workspace:*",
    "@kosh/views": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@kosh/notify": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1"
  }
}
