{
  "name": "@isahaq/kosh-reporting",
  "version": "0.1.0",
  "description": "Pivot engine (GROUPING SETS / ROLLUP / CUBE), comparisons, scheduled reports, PDF designer, Excel export (RFC 0005)",
  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/packages/reporting#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "packages/reporting"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "@kosh/source": "./src/web/index.ts",
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@isahaq/kosh-modules-sdk": "workspace:*",
    "@isahaq/kosh-search": "workspace:*",
    "@isahaq/kosh-server": "workspace:*",
    "@isahaq/kosh-ui": "workspace:*",
    "@isahaq/kosh-views": "workspace:*",
    "echarts": "^6.1.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.14.0",
    "playwright-core": "1.64.1"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "@tanstack/react-query": "^5.104.3",
    "i18next": "^26.4.7",
    "react-i18next": "^17.0.21"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "@tanstack/react-query": "^5.104.3",
    "i18next": "^26.4.7",
    "react-i18next": "^17.0.21"
  }
}
