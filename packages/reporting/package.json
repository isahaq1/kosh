{
  "name": "@kosh/reporting",
  "version": "0.0.0",
  "description": "Pivot engine (GROUPING SETS / ROLLUP / CUBE), comparisons, scheduled reports, PDF designer, Excel export (RFC 0005)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kosh/modules-sdk": "workspace:*",
    "@kosh/server": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1"
  }
}
