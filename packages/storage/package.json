{
  "name": "@isahaq/kosh-storage",
  "version": "0.1.0",
  "description": "Attachments on S3-compatible storage (RFC 0006)",
  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/packages/storage#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "packages/storage"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@isahaq/kosh-modules-sdk": "workspace:*",
    "@isahaq/kosh-server": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "testcontainers": "^12.2.1"
  }
}
