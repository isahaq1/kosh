{
  "name": "@kosh/server",
  "version": "0.0.0",
  "description": "Fastify app, module loader, REST/OpenAPI generator, auth, Shutro environment per request (RFC 0002)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./orm": {
      "@kosh/source": "./src/orm.ts",
      "types": "./dist/orm.d.ts",
      "default": "./dist/orm.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@kosh/modules-sdk": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "fastify": "^5.12.7",
    "iovalkey": "^0.4.0",
    "shutro": "link:../../../shutro/dist-npm/shutro",
    "@kosh/views": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "testcontainers": "^12.2.1",
    "@kosh/search": "workspace:*"
  }
}
