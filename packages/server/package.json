{
  "name": "@kosh/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify app, module loader, REST/OpenAPI generator, auth, Shutro environment per request (RFC 0002)",
  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "packages/server"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./orm": {
      "@kosh/source": "./src/orm.ts",
      "types": "./dist/orm.d.ts",
      "default": "./dist/orm.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@kosh/modules-sdk": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "fastify": "^5.12.7",
    "iovalkey": "^0.4.0",
    "shutro": "^0.3.3",
    "@kosh/views": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "testcontainers": "^12.2.1",
    "@kosh/search": "workspace:*"
  }
}
