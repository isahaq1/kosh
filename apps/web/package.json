    "@kosh/product": "workspace:*",
    "@kosh/sale_account": "workspace:*",
    "@kosh/purchase_account": "workspace:*",
    "@kosh/project": "workspace:*",
    "@kosh/sale_project": "workspace:*",
    "@kosh/mail": "workspace:*"
  }
