{
  "name": "@kosh/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kosh back-office SPA (RFC 0007)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "api:generate": "kosh generate client --modules @kosh/server --out src/api/kosh.gen.ts",
    "api:check": "kosh generate client --modules @kosh/server --out src/api/kosh.gen.ts --check"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@kosh/ui": "workspace:*",
    "@kosh/permissions": "workspace:*",
    "@kosh/reporting": "workspace:*",
    "@kosh/messaging": "workspace:*",
    "@kosh/settings": "workspace:*",
    "@kosh/notify": "workspace:*",
    "@kosh/accounting": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@kosh/cli": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@kosh/server": "workspace:*",
    "@kosh/modules-sdk": "workspace:*",
    "@kosh/views": "workspace:*",
    "@kosh/realtime": "workspace:*",
