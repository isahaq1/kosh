{
  "name": "@kosh/indent_purchase",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge: what the store lacks for an approved indent becomes a purchase request (Requests \u2194 Purchase, RFC 0032)",
  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/modules/indent_purchase#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "modules/indent_purchase"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-views.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kosh/modules-sdk": "workspace:*",
    "@kosh/server": "workspace:*",
    "@kosh/views": "workspace:*",
    "@kosh/indent": "workspace:*",
    "@kosh/purchase": "workspace:*",
    "@kosh/stock": "workspace:*"
  },
  "devDependencies": {
    "@kosh/permissions": "workspace:*",
    "@kosh/settings": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1"
  }
}
