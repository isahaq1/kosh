{
  "name": "@kosh/l10n_bd",
  "version": "0.1.0",
  "private": true,
  "description": "Bangladesh: the chart of accounts, VAT and SD (Mushak), VDS and TDS, BIN and TIN, a July–June fiscal year (RFC 0016)",
  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/modules/l10n_bd#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "modules/l10n_bd"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "@kosh/source": "./src/web/index.ts",
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-views.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kosh/modules-sdk": "workspace:*",
    "@kosh/server": "workspace:*",
    "@kosh/views": "workspace:*",
    "@kosh/accounting": "workspace:*",
    "@kosh/contacts": "workspace:*",
    "@kosh/product": "workspace:*",
    "@kosh/reporting": "workspace:*",
    "@kosh/ui": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@tanstack/react-query": "^5.104.3",
    "@types/react": "^19.3.0",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-i18next": "^17.0.21"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.3",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-i18next": "^17.0.21"
  }
}
