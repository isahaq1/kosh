{
  "name": "@kosh/payroll_account",
  "version": "0.1.0",
  "private": true,
  "description": "Payroll in the books: approved runs booked, payments from the bank, corrections by their differences (RFC 0024)",
  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/modules/payroll_account#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "modules/payroll_account"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-views.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kosh/modules-sdk": "workspace:*",
    "@kosh/server": "workspace:*",
    "@kosh/views": "workspace:*",
    "@kosh/payroll": "workspace:*",
    "@kosh/accounting": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@kosh/settings": "workspace:*",
    "@kosh/hr": "workspace:*",
    "@kosh/attendance": "workspace:*",
    "@kosh/reporting": "workspace:*"
  }
}
