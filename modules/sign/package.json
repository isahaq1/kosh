{
  "name": "@kosh/sign",
  "version": "0.1.0",
  "private": true,
  "description": "Sign: templates with fields per role, signers in order or at once with one-time codes, a sealed PDF with its certificate (RFC 0024)",
  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/modules/sign#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "modules/sign"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-views.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kosh/contacts": "workspace:*",
    "@kosh/documents": "workspace:*",
    "@kosh/mail": "workspace:*",
    "@kosh/messaging": "workspace:*",
    "@kosh/modules-sdk": "workspace:*",
    "@kosh/server": "workspace:*",
    "@kosh/storage": "workspace:*",
    "@kosh/views": "workspace:*",
    "fastify": "^5.12.7",
    "pdf-lib": "1.17.1",
    "@kosh/reporting": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@kosh/settings": "workspace:*",
    "@kosh/permissions": "workspace:*",
    "@kosh/reporting": "workspace:*"
  }
}
