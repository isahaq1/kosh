{
  "name": "@kosh/documents",
  "version": "0.1.0",
  "private": true,
  "description": "Documents: folders, versions, one search with every record’s files, share links and requests for files (RFC 0024)",
  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/modules/documents#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "modules/documents"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "@kosh/source": "./src/web/index.ts",
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-views.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kosh/contacts": "workspace:*",
    "@kosh/mail": "workspace:*",
    "@kosh/messaging": "workspace:*",
    "@kosh/modules-sdk": "workspace:*",
    "@kosh/server": "workspace:*",
    "@kosh/storage": "workspace:*",
    "@kosh/ui": "workspace:*",
    "@kosh/views": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@kosh/settings": "workspace:*",
    "@kosh/permissions": "workspace:*",
    "@kosh/reporting": "workspace:*",
    "@types/react": "^19.3.0",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-i18next": "^17.0.21",
    "@tanstack/react-query": "^5.90.2"
  },
  "peerDependencies": {
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-i18next": "^17.0.21",
    "@tanstack/react-query": "^5.104.3"
  }
}
