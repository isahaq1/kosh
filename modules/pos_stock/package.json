{
  "name": "@kosh/pos_stock",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge: a closed Counter session leaves stock as one delivery (Counter ↔ Stockroom, RFC 0021)",
  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/modules/pos_stock#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "modules/pos_stock"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-views.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kosh/modules-sdk": "workspace:*",
    "@kosh/server": "workspace:*",
    "@kosh/views": "workspace:*",
    "@kosh/pos": "workspace:*",
    "@kosh/stock": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@kosh/settings": "workspace:*",
    "@kosh/messaging": "workspace:*",
    "@kosh/permissions": "workspace:*",
    "@kosh/contacts": "workspace:*",
    "@kosh/product": "workspace:*",
    "@kosh/accounting": "workspace:*",
    "@kosh/reporting": "workspace:*"
  }
}
