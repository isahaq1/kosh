  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/modules/purchase_portal#readme",
