{
  "name": "@kosh/l10n_bd_payroll",
  "version": "0.1.0",
  "private": true,
  "description": "Bangladesh payroll: standard and garments structures, overtime, festival bonuses, provident fund and income tax at source, as data (RFC 0024)",
  "keywords": [
    "kosh",
    "erp",
    "typescript",
    "postgresql",
    "shutro"
  ],
  "author": "Isahaq <hmisahaq01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isahaq1/kosh/tree/main/modules/l10n_bd_payroll#readme",
  "bugs": {
    "url": "https://github.com/isahaq1/kosh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahaq1/kosh.git",
    "directory": "modules/l10n_bd_payroll"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kosh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
