# Copy to .env for local development. Never commit .env (secrets come from the environment or a secret manager).
DATABASE_URL=postgres://kosh:kosh@localhost:5432/kosh
VALKEY_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=kosh-attachments
S3_ACCESS_KEY=kosh
S3_SECRET_KEY=kosh-secret
SMTP_URL=smtp://localhost:1025
MAILPIT_UI=http://localhost:8025

# Replies by email (RFC 0006 part 7): the inbound mailbox domain and the secrets (kosh init generates them).
# MAIL_INBOUND_SECRET=change-me
# MAIL_INBOUND_DOMAIN=mail.example.com
# MAIL_INBOUND_ALIAS=reply
# MAIL_INBOUND_WEBHOOK_SECRET=change-me
